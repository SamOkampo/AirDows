# Runtime
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000

# TURN. Configure either your existing provider or Metered; never both blindly.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
METERED_DOMAIN=
METERED_API_KEY=

# Optional persistence and private observability
METRICS_DATABASE_URL=
METRICS_DATABASE_SSL=true
ADMIN_DASHBOARD_TOKEN=
FREE_RELAY_BUDGET_BYTES=262144000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
